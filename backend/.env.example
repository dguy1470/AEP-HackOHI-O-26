# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Claude chat proxy (lets the site use AI without a per-user key) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Nominatim geocoding (any descriptive UA is fine) ---
NOMINATIM_USER_AGENT=OutageConcierge/1.0 (you@example.com)

# --- Email notifications (SMTP). Leave blank to run in demo mode (logs only). ---
# Gmail example: make an "App Password" (Google Account > Security > 2-Step
# Verification > App passwords), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=the-16-char-app-password
#   SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@example.com

# --- Database (SQLite file path; default is backend/concierge.db) ---
DB_PATH=

# --- Admin token guarding /api/subscribers, /api/broadcast, /api/send-test ---
# Set any long random string; send it as the X-Admin-Token header.
ADMIN_TOKEN=

# Comma-separated allowed browser origins. "*" is fine locally.
ALLOWED_ORIGINS=*
