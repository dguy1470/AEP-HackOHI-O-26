# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Claude chat proxy (lets the site use AI without a per-user key) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Nominatim geocoding (any descriptive UA is fine) ---
NOMINATIM_USER_AGENT=OutageConcierge/1.0 (you@example.com)

# --- Email notifications via Resend (https://resend.com — free tier, no credit card) ---
# 1. Sign up at resend.com
# 2. Go to API Keys and create one
# 3. Paste it below
# The RESEND_FROM address below works on the free tier without a custom domain.
# Once you have a domain you can change it to something like: Outage Concierge <alerts@yourdomain.com>
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Outage Concierge <onboarding@resend.dev>

# --- Database (SQLite file path; default is backend/concierge.db) ---
DB_PATH=

# --- Admin token guarding /api/subscribers, /api/broadcast ---
# Set any long random string; send it as the X-Admin-Token header.
ADMIN_TOKEN=

# Comma-separated allowed browser origins. "*" is fine locally.
ALLOWED_ORIGINS=*
