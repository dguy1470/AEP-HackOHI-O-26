# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Claude chat proxy (lets the site use AI without a per-user key) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Nominatim geocoding (any descriptive UA is fine) ---
NOMINATIM_USER_AGENT=OutageConcierge/1.0 (you@example.com)

# --- Email notifications (SMTP). Leave blank to run in demo mode (logs only). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@example.com

# --- SMS notifications (Twilio). Leave blank to run in demo mode (logs only). ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated allowed browser origins. "*" is fine locally.
ALLOWED_ORIGINS=*
